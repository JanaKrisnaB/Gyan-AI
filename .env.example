# GNANI_API_KEY / X_API_KEY_ID: API key for Gnani.ai Vachana services (Prisma v3.0 STT & Timbre v3.0 TTS)
# Global Authentication Header: X-API-Key-ID
GNANI_API_KEY=""
X_API_KEY_ID=""
GNANI_BASE_URL="https://vachana.ai"
GNANI_STT_URL="https://api.vachana.ai/stt/v3"
GNANI_STT_STREAM_URL="wss://api.vachana.ai/stt/v3/stream"
GNANI_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"

# GNANI EVON (30B) LLM: Open-weights 30B parameter model (gnani/gnani-evon-v3.3-30B-A3B)
# Model on Hugging Face: https://huggingface.co/gnani/gnani-evon-v3.3-30B-A3B
# Option A: Hugging Face API Token (for Inference API or downloading weights)
HF_TOKEN=""
# Option B: Local/Remote vLLM or TGI endpoint serving gnani/gnani-evon-v3.3-30B-A3B
EVON_API_URL=""
# Option C: Set to "true" to load weights locally via transformers pipeline
USE_LOCAL_EVON="false"

# GEMINI_API_KEY: Alternative/Fallback LLM engine
GEMINI_API_KEY=""
LLM_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
PORT="3000"

